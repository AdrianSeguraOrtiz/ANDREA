{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/simulator-output-manifest.schema.json",
  "title": "ANDREA SimulatorOutputManifest",
  "description": "Normalized simulator-wrapper output contract consumed by generate-data core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "simulator_id",
    "profile",
    "seed",
    "expression",
    "extras",
    "native_outputs",
    "truth",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "simulator_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "genes", "columns", "column_kind", "expression_profile"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": ".*\\.tsv$" },
        "genes": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "column_kind": {
          "type": "string",
          "enum": ["samples", "cells", "timepoints", "perturbations"]
        },
        "expression_profile": {
          "type": "string",
          "enum": ["bulk", "scrna", "mixed", "unknown"]
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": { "type": ["string", "null"], "pattern": ".*\\.tsv$" },
        "cell_phenotypes": { "type": ["string", "null"], "pattern": ".*\\.tsv$" },
        "cluster_identities": { "type": ["string", "null"], "pattern": ".*\\.tsv$" },
        "enrichment_background": { "type": ["string", "null"], "pattern": ".*\\.txt$" },
        "lineage_tree": { "type": ["string", "null"], "pattern": ".*\\.tsv$" },
        "pseudotime": { "type": ["string", "null"], "pattern": ".*\\.tsv$" },
        "prior_grn": { "type": ["string", "null"], "pattern": ".*\\.tsv$" },
        "tf_list": { "type": ["string", "null"], "pattern": ".*\\.txt$" },
        "prior_grn_by_group": { "type": ["string", "null"], "pattern": ".*\\.tsv$" }
      }
    },
    "native_outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gene_universe", "networks"],
      "properties": {
        "gene_universe": { "type": "string", "pattern": ".*\\.txt$" },
        "networks": { "type": "string", "pattern": ".*\\.csv$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_dir"],
      "properties": {
        "raw_dir": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
