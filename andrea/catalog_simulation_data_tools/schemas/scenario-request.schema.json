{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/scenario-request.schema.json",
  "title": "ANDREA ScenarioRequest",
  "description": "Scenario-first request contract for generate-data preflight and planning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile",
    "organism",
    "requested_extras"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "bulk_steady_state",
        "bulk_time_series",
        "bulk_perturbational",
        "scrna_global",
        "scrna_grouped"
      ]
    },
    "organism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomic_group", "ncbi_taxon_id"],
      "properties": {
        "taxonomic_group": {
          "type": "string",
          "enum": ["animal", "plant", "fungi", "bacteria", "archaea", "protist", "viral", "synthetic", "unknown"]
        },
        "ncbi_taxon_id": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "taxonomic_group": {
                "enum": ["animal", "plant", "fungi", "bacteria", "archaea", "protist", "viral"]
              }
            },
            "required": ["taxonomic_group"]
          },
          "then": {
            "properties": {
              "ncbi_taxon_id": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "organism": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taxonomic_group", "ncbi_taxon_id"],
            "properties": {
              "taxonomic_group": {
                "type": "string",
                "enum": ["animal", "plant", "fungi", "bacteria", "archaea", "protist", "viral", "synthetic", "unknown"]
              },
              "ncbi_taxon_id": {
                "anyOf": [
                  { "type": "integer", "minimum": 1 },
                  { "type": "null" }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "taxonomic_group": {
                      "enum": ["animal", "plant", "fungi", "bacteria", "archaea", "protist", "viral"]
                    }
                  },
                  "required": ["taxonomic_group"]
                },
                "then": {
                  "properties": {
                    "ncbi_taxon_id": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requested_extras": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["groups", "lineage_tree", "tf_list", "prior_grn_by_group", "group_networks"]
      }
    },
    "base_seed": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
