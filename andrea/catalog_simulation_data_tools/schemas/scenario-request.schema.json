{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/scenario-request.schema.json",
  "title": "ANDREA ScenarioRequest",
  "description": "Scenario-first request contract for generate-data preflight and planning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "data_axes",
    "truth_requirements",
    "organism",
    "requested_extras"
  ],
  "$defs": {
    "data_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "resolution",
        "column_kind",
        "experimental_design"
      ],
      "properties": {
        "measurement": {
          "type": "string",
          "enum": [
            "rna_expression"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "bulk",
            "single_cell",
            "spatial",
            "pseudo_bulk",
            "mixed",
            "unknown"
          ]
        },
        "column_kind": {
          "type": "string",
          "enum": [
            "samples",
            "cells",
            "timepoints",
            "perturbations",
            "spots",
            "metacells",
            "conditions"
          ]
        },
        "experimental_design": {
          "type": "string",
          "enum": [
            "observational",
            "steady_state",
            "perturbational",
            "time_series",
            "trajectory",
            "differentiation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "cells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "single_cell"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "spots"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "spatial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "metacells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "enum": [
                  "single_cell",
                  "pseudo_bulk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "time_series"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "timepoints",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "perturbational"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "perturbations",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        }
      ]
    },
    "truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "global",
              "group",
              "column"
            ]
          },
          "contains": {
            "const": "global"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "data_axes": {
      "$ref": "#/$defs/data_axes"
    },
    "truth_requirements": {
      "$ref": "#/$defs/truth_requirements"
    },
    "organism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxonomic_group",
        "ncbi_taxon_id"
      ],
      "properties": {
        "taxonomic_group": {
          "type": "string",
          "enum": [
            "animal",
            "plant",
            "fungi",
            "bacteria",
            "archaea",
            "protist",
            "viral",
            "synthetic",
            "unknown"
          ]
        },
        "ncbi_taxon_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "taxonomic_group": {
                "enum": [
                  "animal",
                  "plant",
                  "fungi",
                  "bacteria",
                  "archaea",
                  "protist",
                  "viral"
                ]
              }
            },
            "required": [
              "taxonomic_group"
            ]
          },
          "then": {
            "properties": {
              "ncbi_taxon_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "organism": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taxonomic_group",
              "ncbi_taxon_id"
            ],
            "properties": {
              "taxonomic_group": {
                "type": "string",
                "enum": [
                  "animal",
                  "plant",
                  "fungi",
                  "bacteria",
                  "archaea",
                  "protist",
                  "viral",
                  "synthetic",
                  "unknown"
                ]
              },
              "ncbi_taxon_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "taxonomic_group": {
                      "enum": [
                        "animal",
                        "plant",
                        "fungi",
                        "bacteria",
                        "archaea",
                        "protist",
                        "viral"
                      ]
                    }
                  },
                  "required": [
                    "taxonomic_group"
                  ]
                },
                "then": {
                  "properties": {
                    "ncbi_taxon_id": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requested_extras": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "groups",
          "column_descriptors",
          "column_phenotypes",
          "cluster_identities",
          "enrichment_background",
          "interventions",
          "lineage_tree",
          "perturbation_design",
          "pseudotime",
          "prior_grn",
          "prior_grn_by_group",
          "replicates",
          "tf_list",
          "timepoints",
          "spatial_coordinates",
          "chromatin_accessibility",
          "chromatin_regions",
          "cell_cell_interactions"
        ]
      }
    },
    "base_seed": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
