{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/preflight-report.schema.json",
  "title": "ANDREA GenerateDataPreflightReport",
  "description": "Scenario-first simulator classification report for generate-data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "catalog_summary",
    "eligible",
    "warning",
    "blocked"
  ],
  "$defs": {
    "simulator_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulator_id",
        "name",
        "requested_data_axes",
        "requested_truth_requirements",
        "requested_extras",
        "effective_extras",
        "inputs_used",
        "native_extras_used",
        "derived_extras_used",
        "truth_outputs",
        "status",
        "issues"
      ],
      "properties": {
        "simulator_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "requested_extras": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effective_extras": {
          "type": "array",
          "contains": {
            "const": "tf_list"
          },
          "items": {
            "type": "string"
          }
        },
        "inputs_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_extras_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived_extras_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truth_outputs": {
          "$ref": "#/$defs/truth_outputs"
        },
        "status": {
          "type": "string",
          "enum": [
            "eligible",
            "warning",
            "blocked"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "severity",
              "code",
              "message"
            ],
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "block",
                  "warn",
                  "info"
                ]
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "requested_data_axes": {
          "$ref": "#/$defs/data_axes"
        },
        "requested_truth_requirements": {
          "$ref": "#/$defs/truth_requirements"
        }
      }
    },
    "data_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "resolution",
        "column_kind",
        "experimental_design"
      ],
      "properties": {
        "measurement": {
          "type": "string",
          "enum": [
            "rna_expression"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "bulk",
            "single_cell",
            "spatial",
            "pseudo_bulk",
            "mixed",
            "unknown"
          ]
        },
        "column_kind": {
          "type": "string",
          "enum": [
            "samples",
            "cells",
            "timepoints",
            "perturbations",
            "spots",
            "metacells",
            "conditions"
          ]
        },
        "experimental_design": {
          "type": "string",
          "enum": [
            "observational",
            "steady_state",
            "perturbational",
            "time_series",
            "trajectory",
            "differentiation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "cells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "single_cell"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "spots"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "spatial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "metacells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "enum": [
                  "single_cell",
                  "pseudo_bulk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "time_series"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "timepoints",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "perturbational"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "perturbations",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        }
      ]
    },
    "truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "global",
              "group",
              "column"
            ]
          },
          "contains": {
            "const": "global"
          }
        }
      }
    },
    "truth_outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/truth_output"
      }
    },
    "truth_context_family": {
      "type": "string",
      "enum": [
        "global",
        "group",
        "column"
      ]
    },
    "truth_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "status"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/truth_context_family"
        },
        "status": {
          "type": "string",
          "enum": [
            "native",
            "derivable"
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "data_axes",
        "truth_requirements",
        "organism",
        "requested_extras",
        "effective_extras",
        "inputs",
        "base_seed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "organism": {
          "type": "object"
        },
        "requested_extras": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effective_extras": {
          "type": "array",
          "contains": {
            "const": "tf_list"
          },
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "object"
        },
        "base_seed": {
          "type": "integer"
        },
        "data_axes": {
          "$ref": "#/$defs/data_axes"
        },
        "truth_requirements": {
          "$ref": "#/$defs/truth_requirements"
        }
      }
    },
    "catalog_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "eligible",
        "warning",
        "blocked"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "eligible": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simulator_entry"
      }
    },
    "warning": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simulator_entry"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simulator_entry"
      }
    }
  }
}
