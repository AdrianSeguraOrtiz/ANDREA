{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/preflight-report.schema.json",
  "title": "ANDREA GenerateDataPreflightReport",
  "description": "Scenario-first simulator classification report for generate-data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "catalog_summary",
    "eligible",
    "warning",
    "blocked"
  ],
  "$defs": {
    "simulator_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulator_id",
        "name",
        "requested_profile",
        "requested_extras",
        "effective_extras",
        "inputs_used",
        "native_extras_used",
        "derived_extras_used",
        "truth_outputs",
        "status",
        "issues"
      ],
      "properties": {
        "simulator_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "requested_profile": { "type": "string", "minLength": 1 },
        "requested_extras": {
          "type": "array",
          "items": { "type": "string" }
        },
        "effective_extras": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "native_extras_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "derived_extras_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "truth_outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global", "group"],
          "properties": {
            "global": {
              "type": "string",
              "enum": ["none", "native", "derivable"]
            },
            "group": {
              "type": "string",
              "enum": ["none", "native", "derivable"]
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["eligible", "warning", "blocked"]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["severity", "code", "message"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["block", "warn", "info"]
              },
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "organism",
        "requested_extras",
        "effective_extras",
        "inputs",
        "base_seed"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "organism": { "type": "object" },
        "requested_extras": {
          "type": "array",
          "items": { "type": "string" }
        },
        "effective_extras": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "object"
        },
        "base_seed": { "type": "integer" }
      }
    },
    "catalog_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "eligible", "warning", "blocked"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "eligible": {
      "type": "array",
      "items": { "$ref": "#/$defs/simulator_entry" }
    },
    "warning": {
      "type": "array",
      "items": { "$ref": "#/$defs/simulator_entry" }
    },
    "blocked": {
      "type": "array",
      "items": { "$ref": "#/$defs/simulator_entry" }
    }
  }
}
