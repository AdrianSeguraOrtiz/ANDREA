{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/ground-truth-manifest.schema.json",
  "title": "ANDREA GroundTruthManifest",
  "description": "Truth artefact index for one generated dataset package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "simulator_id",
    "data_axes",
    "truth_requirements",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "simulator_id": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gene_universe",
        "networks"
      ],
      "properties": {
        "gene_universe": {
          "type": "string",
          "pattern": ".*\\.txt$"
        },
        "networks": {
          "type": "string",
          "pattern": ".*\\.csv$"
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "data_axes": {
      "$ref": "#/$defs/data_axes"
    },
    "truth_requirements": {
      "$ref": "#/$defs/truth_requirements"
    }
  },
  "$defs": {
    "data_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "resolution",
        "column_kind",
        "experimental_design"
      ],
      "properties": {
        "measurement": {
          "type": "string",
          "enum": [
            "rna_expression"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "bulk",
            "single_cell",
            "spatial",
            "pseudo_bulk",
            "mixed",
            "unknown"
          ]
        },
        "column_kind": {
          "type": "string",
          "enum": [
            "samples",
            "cells",
            "timepoints",
            "perturbations",
            "spots",
            "metacells",
            "conditions"
          ]
        },
        "experimental_design": {
          "type": "string",
          "enum": [
            "observational",
            "steady_state",
            "perturbational",
            "time_series",
            "trajectory",
            "differentiation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "cells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "single_cell"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "spots"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "spatial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "metacells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "enum": [
                  "single_cell",
                  "pseudo_bulk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "time_series"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "timepoints",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "perturbational"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "perturbations",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        }
      ]
    },
    "truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "global",
              "group",
              "column"
            ]
          },
          "contains": {
            "const": "global"
          }
        }
      }
    }
  }
}
