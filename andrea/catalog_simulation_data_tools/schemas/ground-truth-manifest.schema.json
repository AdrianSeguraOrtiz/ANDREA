{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/ground-truth-manifest.schema.json",
  "title": "ANDREA GroundTruthManifest",
  "description": "Truth artefact index for one generated dataset package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_fingerprint",
    "simulator_id",
    "data_axes",
    "truth_requirements",
    "outputs",
    "candidate_space"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_fingerprint": {
      "$ref": "#/$defs/dataset_fingerprint"
    },
    "simulator_id": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gene_universe",
        "networks"
      ],
      "properties": {
        "gene_universe": {
          "$ref": "#/$defs/safe_relative_txt_path"
        },
        "networks": {
          "$ref": "#/$defs/safe_relative_csv_path"
        }
      }
    },
    "candidate_space": {
      "description": "Required directed evaluation universe. Truth and predictions are intersected with this space per metric level; excluded rows are reported. Paths are relative to this manifest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "targets",
        "allow_self_edges"
      ],
      "properties": {
        "sources": {
          "description": "Line-delimited unique candidate regulator identifiers, normally extras/tf_list.txt; every identifier must belong to outputs.gene_universe.",
          "$ref": "#/$defs/safe_relative_txt_path"
        },
        "targets": {
          "description": "Line-delimited unique candidate target identifiers, normally outputs.gene_universe; every identifier must belong to outputs.gene_universe.",
          "$ref": "#/$defs/safe_relative_txt_path"
        },
        "allow_self_edges": {
          "description": "Whether source-target pairs with the same identifier belong to the candidate universe.",
          "type": "boolean",
          "const": false
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "data_axes": {
      "$ref": "#/$defs/data_axes"
    },
    "truth_requirements": {
      "$ref": "#/$defs/truth_requirements"
    }
  },
  "$defs": {
    "dataset_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "safe_relative_txt_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\s)(?!.*\\s$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[^\\\\\\x00-\\x1F]+\\.txt$",
      "description": "Canonical POSIX path relative to the manifest: no absolute or drive-prefixed path, backslash, control character, surrounding whitespace, empty segment, '.' segment or '..' segment."
    },
    "safe_relative_csv_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\s)(?!.*\\s$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[^\\\\\\x00-\\x1F]+\\.csv$",
      "description": "Canonical POSIX path relative to the manifest: no absolute or drive-prefixed path, backslash, control character, surrounding whitespace, empty segment, '.' segment or '..' segment."
    },
    "data_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "resolution",
        "column_kind",
        "experimental_design"
      ],
      "properties": {
        "measurement": {
          "type": "string",
          "enum": [
            "rna_expression"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "bulk",
            "single_cell",
            "spatial",
            "pseudo_bulk",
            "mixed",
            "unknown"
          ]
        },
        "column_kind": {
          "type": "string",
          "enum": [
            "samples",
            "cells",
            "timepoints",
            "perturbations",
            "spots",
            "metacells",
            "conditions"
          ]
        },
        "experimental_design": {
          "type": "string",
          "enum": [
            "observational",
            "steady_state",
            "perturbational",
            "time_series",
            "trajectory",
            "differentiation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "cells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "single_cell"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "spots"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "spatial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "metacells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "enum": [
                  "single_cell",
                  "pseudo_bulk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "time_series"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "timepoints",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "perturbational"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "perturbations",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        }
      ]
    },
    "truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "global",
              "group",
              "column"
            ]
          },
          "contains": {
            "const": "global"
          }
        }
      }
    }
  }
}
