{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/benchmark-manifest.schema.json",
  "title": "ANDREA BenchmarkManifest",
  "description": "Top-level manifest indexing a generated benchmark package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile",
    "organism",
    "requested_extras",
    "effective_extras",
    "inputs",
    "runs",
    "tasks",
    "execution",
    "datasets",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": { "type": "string", "minLength": 1 },
    "profile": {
      "type": "string",
      "enum": [
        "bulk_steady_state",
        "bulk_time_series",
        "bulk_perturbational",
        "scrna_global",
        "scrna_grouped",
        "scrna_cell_specific"
      ]
    },
    "organism": { "type": "object" },
    "requested_extras": {
      "type": "array",
      "items": { "type": "string" }
    },
    "effective_extras": {
      "type": "array",
      "items": { "type": "string" }
    },
    "base_seed": { "type": ["integer", "null"] },
    "inputs": { "type": "object" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "simulator_id",
          "replicates",
          "base_seed",
          "replicate_seeds",
          "resolved_simulator_params",
          "runtime_resources",
          "ram_gb",
          "eta_seconds",
          "eta_source",
          "eta_start_seconds",
          "eta_end_seconds",
          "eta_provenance"
        ],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "simulator_id": { "type": "string", "minLength": 1 },
          "replicates": { "type": "integer", "minimum": 1 },
          "native_outputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "base_seed": { "type": "integer" },
          "replicate_seeds": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "resolved_simulator_params": { "type": "object" },
          "runtime_resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["threads"],
            "properties": {
              "threads": { "type": "integer", "minimum": 1 }
            }
          },
          "ram_gb": { "type": "number", "exclusiveMinimum": 0 },
          "eta_seconds": { "type": "number", "minimum": 0 },
          "eta_source": { "type": "string", "minLength": 1 },
          "eta_start_seconds": { "type": "number", "minimum": 0 },
          "eta_end_seconds": { "type": "number", "minimum": 0 },
          "eta_provenance": { "type": "object" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "run_id",
          "simulator_id",
          "replicate_index",
          "seed",
          "dataset_id",
          "runtime_resources",
          "ram_gb",
          "eta_seconds",
          "eta_source",
          "eta_start_seconds",
          "eta_end_seconds",
          "eta_wave",
          "eta_provenance"
        ],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "simulator_id": { "type": "string", "minLength": 1 },
          "replicate_index": { "type": "integer", "minimum": 1 },
          "seed": { "type": "integer" },
          "dataset_id": { "type": "string", "minLength": 1 },
          "runtime_resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["threads"],
            "properties": {
              "threads": { "type": "integer", "minimum": 1 }
            }
          },
          "ram_gb": { "type": "number", "exclusiveMinimum": 0 },
          "eta_seconds": { "type": "number", "minimum": 0 },
          "eta_source": { "type": "string", "minLength": 1 },
          "eta_start_seconds": { "type": "number", "minimum": 0 },
          "eta_end_seconds": { "type": "number", "minimum": 0 },
          "eta_wave": { "type": "integer", "minimum": 1 },
          "eta_provenance": { "type": "object" }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_parallel_tasks",
        "max_cores",
        "max_ram_gb",
        "eta_total_seconds",
        "waves",
        "warnings"
      ],
      "properties": {
        "max_parallel_tasks": { "type": "integer", "minimum": 1 },
        "max_cores": { "type": "integer", "minimum": 1 },
        "max_ram_gb": { "type": "number", "exclusiveMinimum": 0 },
        "eta_total_seconds": { "type": "number", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "threads_used",
              "ram_gb_used",
              "eta_seconds",
              "eta_start_seconds",
              "eta_end_seconds",
              "tasks"
            ],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "threads_used": { "type": "integer", "minimum": 1 },
              "ram_gb_used": { "type": "number", "exclusiveMinimum": 0 },
              "eta_seconds": { "type": "number", "minimum": 0 },
              "eta_start_seconds": { "type": "number", "minimum": 0 },
              "eta_end_seconds": { "type": "number", "minimum": 0 },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "task_id",
                    "run_id",
                    "simulator_id",
                    "threads",
                    "ram_gb",
                    "eta_seconds",
                    "eta_source",
                    "eta_start_seconds",
                    "eta_end_seconds"
                  ],
                  "properties": {
                    "task_id": { "type": "string", "minLength": 1 },
                    "run_id": { "type": "string", "minLength": 1 },
                    "simulator_id": { "type": "string", "minLength": 1 },
                    "threads": { "type": "integer", "minimum": 1 },
                    "ram_gb": { "type": "number", "exclusiveMinimum": 0 },
                    "eta_seconds": { "type": "number", "minimum": 0 },
                    "eta_source": { "type": "string", "minLength": 1 },
                    "eta_start_seconds": { "type": "number", "minimum": 0 },
                    "eta_end_seconds": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "run_id",
          "simulator_id",
          "seed",
          "path",
          "dataset_manifest",
          "ground_truth_manifest"
        ],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "simulator_id": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "path": { "type": "string", "minLength": 1 },
          "dataset_manifest": { "type": "string", "minLength": 1 },
          "ground_truth_manifest": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "run_id",
          "simulator_id",
          "expression_matrix",
          "gene_universe",
          "networks"
        ],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "simulator_id": { "type": "string", "minLength": 1 },
          "expression_matrix": { "type": "string", "minLength": 1 },
          "gene_universe": { "type": "string", "minLength": 1 },
          "groups": { "type": ["string", "null"] },
          "cell_phenotypes": { "type": ["string", "null"] },
          "cluster_identities": { "type": ["string", "null"] },
          "enrichment_background": { "type": ["string", "null"] },
          "lineage_tree": { "type": ["string", "null"] },
          "pseudotime": { "type": ["string", "null"] },
          "prior_grn": { "type": ["string", "null"] },
          "tf_list": { "type": ["string", "null"] },
          "prior_grn_by_group": { "type": ["string", "null"] },
          "native_outputs": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "networks": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
