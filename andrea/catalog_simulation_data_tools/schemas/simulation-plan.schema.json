{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/simulation-plan.schema.json",
  "title": "ANDREA SimulationPlan",
  "description": "Frozen executable plan for generate-data benchmark creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile",
    "organism",
    "requested_extras",
    "effective_extras",
    "inputs",
    "runs",
    "tasks",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "bulk_steady_state",
        "bulk_time_series",
        "bulk_perturbational",
        "scrna_global",
        "scrna_grouped"
      ]
    },
    "organism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomic_group", "ncbi_taxon_id"],
      "properties": {
        "taxonomic_group": {
          "type": "string",
          "enum": ["animal", "plant", "fungi", "bacteria", "archaea", "protist", "viral", "synthetic", "unknown"]
        },
        "ncbi_taxon_id": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "taxonomic_group": {
                "enum": ["animal", "plant", "fungi", "bacteria", "archaea", "protist", "viral"]
              }
            },
            "required": ["taxonomic_group"]
          },
          "then": {
            "properties": {
              "ncbi_taxon_id": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ]
    },
    "requested_extras": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "groups",
          "cell_phenotypes",
          "cluster_identities",
          "enrichment_background",
          "lineage_tree",
          "pseudotime",
          "prior_grn",
          "tf_list",
          "prior_grn_by_group"
        ]
      }
    },
    "effective_extras": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "groups",
          "cell_phenotypes",
          "cluster_identities",
          "enrichment_background",
          "lineage_tree",
          "pseudotime",
          "prior_grn",
          "tf_list",
          "prior_grn_by_group"
        ]
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "simulator_id",
          "simulator_params",
          "runtime_resources",
          "ram_gb",
          "eta_seconds",
          "eta_source",
          "eta_start_seconds",
          "eta_end_seconds",
          "eta_provenance",
          "replicates",
          "base_seed",
          "replicate_seeds"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "simulator_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "simulator_params": {
            "type": "object"
          },
          "runtime_resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["threads"],
            "properties": {
              "threads": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "ram_gb": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "eta_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_source": {
            "type": "string",
            "minLength": 1
          },
          "eta_start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_provenance": {
            "type": "object"
          },
          "replicates": {
            "type": "integer",
            "minimum": 1
          },
          "native_outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "base_seed": {
            "type": "integer",
            "minimum": 1
          },
          "replicate_seeds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "run_id",
          "simulator_id",
          "replicate_index",
          "seed",
          "dataset_id",
          "runtime_resources",
          "ram_gb",
          "eta_seconds",
          "eta_source",
          "eta_start_seconds",
          "eta_end_seconds",
          "eta_wave",
          "eta_provenance"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "simulator_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "replicate_index": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 1
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "runtime_resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["threads"],
            "properties": {
              "threads": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "ram_gb": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "eta_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_source": {
            "type": "string",
            "minLength": 1
          },
          "eta_start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_wave": {
            "type": "integer",
            "minimum": 1
          },
          "eta_provenance": {
            "type": "object"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_parallel_tasks",
        "max_cores",
        "max_ram_gb",
        "eta_total_seconds",
        "waves",
        "warnings"
      ],
      "properties": {
        "max_parallel_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "max_cores": {
          "type": "integer",
          "minimum": 1
        },
        "max_ram_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "eta_total_seconds": {
          "type": "number",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "threads_used",
              "ram_gb_used",
              "eta_seconds",
              "eta_start_seconds",
              "eta_end_seconds",
              "tasks"
            ],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "threads_used": { "type": "integer", "minimum": 1 },
              "ram_gb_used": { "type": "number", "exclusiveMinimum": 0 },
              "eta_seconds": { "type": "number", "minimum": 0 },
              "eta_start_seconds": { "type": "number", "minimum": 0 },
              "eta_end_seconds": { "type": "number", "minimum": 0 },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "task_id",
                    "run_id",
                    "simulator_id",
                    "threads",
                    "ram_gb",
                    "eta_seconds",
                    "eta_source",
                    "eta_start_seconds",
                    "eta_end_seconds"
                  ],
                  "properties": {
                    "task_id": { "type": "string", "minLength": 1 },
                    "run_id": { "type": "string", "minLength": 1 },
                    "simulator_id": { "type": "string", "minLength": 1 },
                    "threads": { "type": "integer", "minimum": 1 },
                    "ram_gb": { "type": "number", "exclusiveMinimum": 0 },
                    "eta_seconds": { "type": "number", "minimum": 0 },
                    "eta_source": { "type": "string", "minLength": 1 },
                    "eta_start_seconds": { "type": "number", "minimum": 0 },
                    "eta_end_seconds": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "base_seed": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
