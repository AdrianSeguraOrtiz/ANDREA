{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/simulation-plan.schema.json",
  "title": "ANDREA SimulationPlan",
  "description": "Frozen executable plan for generate-data benchmark creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "data_axes",
    "truth_requirements",
    "organism",
    "requested_extras",
    "effective_extras",
    "inputs",
    "runs",
    "tasks",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "organism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxonomic_group",
        "ncbi_taxon_id"
      ],
      "properties": {
        "taxonomic_group": {
          "type": "string",
          "enum": [
            "animal",
            "plant",
            "fungi",
            "bacteria",
            "archaea",
            "protist",
            "viral",
            "synthetic",
            "unknown"
          ]
        },
        "ncbi_taxon_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "taxonomic_group": {
                "enum": [
                  "animal",
                  "plant",
                  "fungi",
                  "bacteria",
                  "archaea",
                  "protist",
                  "viral"
                ]
              }
            },
            "required": [
              "taxonomic_group"
            ]
          },
          "then": {
            "properties": {
              "ncbi_taxon_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "requested_extras": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "groups",
          "column_descriptors",
          "column_phenotypes",
          "cluster_identities",
          "enrichment_background",
          "interventions",
          "lineage_tree",
          "perturbation_design",
          "pseudotime",
          "prior_grn",
          "prior_grn_by_group",
          "replicates",
          "tf_list",
          "timepoints",
          "spatial_coordinates",
          "chromatin_accessibility",
          "chromatin_regions",
          "cell_cell_interactions"
        ]
      }
    },
    "effective_extras": {
      "type": "array",
      "uniqueItems": true,
      "contains": {
        "const": "tf_list"
      },
      "items": {
        "type": "string",
        "enum": [
          "groups",
          "column_descriptors",
          "column_phenotypes",
          "cluster_identities",
          "enrichment_background",
          "interventions",
          "lineage_tree",
          "perturbation_design",
          "pseudotime",
          "prior_grn",
          "prior_grn_by_group",
          "replicates",
          "tf_list",
          "timepoints",
          "spatial_coordinates",
          "chromatin_accessibility",
          "chromatin_regions",
          "cell_cell_interactions"
        ]
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "simulator_id",
          "simulator_params",
          "runtime_resources",
          "ram_gb",
          "eta_seconds",
          "eta_source",
          "eta_start_seconds",
          "eta_end_seconds",
          "eta_provenance",
          "replicates",
          "base_seed",
          "replicate_seeds"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "simulator_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "simulator_params": {
            "type": "object"
          },
          "runtime_resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threads"
            ],
            "properties": {
              "threads": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "ram_gb": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "eta_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_source": {
            "type": "string",
            "minLength": 1
          },
          "eta_start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_provenance": {
            "type": "object"
          },
          "replicates": {
            "type": "integer",
            "minimum": 1
          },
          "native_outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "base_seed": {
            "type": "integer",
            "minimum": 1
          },
          "replicate_seeds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "run_id",
          "simulator_id",
          "replicate_index",
          "seed",
          "dataset_id",
          "runtime_resources",
          "ram_gb",
          "eta_seconds",
          "eta_source",
          "eta_start_seconds",
          "eta_end_seconds",
          "eta_wave",
          "eta_provenance"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "simulator_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "replicate_index": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 1
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "runtime_resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threads"
            ],
            "properties": {
              "threads": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "ram_gb": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "eta_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_source": {
            "type": "string",
            "minLength": 1
          },
          "eta_start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "eta_wave": {
            "type": "integer",
            "minimum": 1
          },
          "eta_provenance": {
            "type": "object"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_parallel_tasks",
        "max_cores",
        "max_ram_gb",
        "eta_total_seconds",
        "waves",
        "warnings"
      ],
      "properties": {
        "max_parallel_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "max_cores": {
          "type": "integer",
          "minimum": 1
        },
        "max_ram_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "eta_total_seconds": {
          "type": "number",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "threads_used",
              "ram_gb_used",
              "eta_seconds",
              "eta_start_seconds",
              "eta_end_seconds",
              "tasks"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "threads_used": {
                "type": "integer",
                "minimum": 1
              },
              "ram_gb_used": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "eta_seconds": {
                "type": "number",
                "minimum": 0
              },
              "eta_start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "eta_end_seconds": {
                "type": "number",
                "minimum": 0
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "task_id",
                    "run_id",
                    "simulator_id",
                    "threads",
                    "ram_gb",
                    "eta_seconds",
                    "eta_source",
                    "eta_start_seconds",
                    "eta_end_seconds"
                  ],
                  "properties": {
                    "task_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "simulator_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "threads": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "ram_gb": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "eta_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "eta_source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "eta_start_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "eta_end_seconds": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "base_seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "data_axes": {
      "$ref": "#/$defs/data_axes"
    },
    "truth_requirements": {
      "$ref": "#/$defs/truth_requirements"
    }
  },
  "$defs": {
    "data_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "resolution",
        "column_kind",
        "experimental_design"
      ],
      "properties": {
        "measurement": {
          "type": "string",
          "enum": [
            "rna_expression"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "bulk",
            "single_cell",
            "spatial",
            "pseudo_bulk",
            "mixed",
            "unknown"
          ]
        },
        "column_kind": {
          "type": "string",
          "enum": [
            "samples",
            "cells",
            "timepoints",
            "perturbations",
            "spots",
            "metacells",
            "conditions"
          ]
        },
        "experimental_design": {
          "type": "string",
          "enum": [
            "observational",
            "steady_state",
            "perturbational",
            "time_series",
            "trajectory",
            "differentiation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "cells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "single_cell"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "spots"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "spatial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "metacells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "enum": [
                  "single_cell",
                  "pseudo_bulk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "time_series"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "timepoints",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "perturbational"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "perturbations",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        }
      ]
    },
    "truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "global",
              "group",
              "column"
            ]
          },
          "contains": {
            "const": "global"
          }
        }
      }
    }
  }
}
