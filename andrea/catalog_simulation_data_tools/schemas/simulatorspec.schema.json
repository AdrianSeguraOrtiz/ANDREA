{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/simulator-spec.schema.json",
  "title": "ANDREA SimulatorSpec",
  "description": "Operational and scientific schema for benchmark data simulators used by generate-data. This schema describes what a simulator can model, which auxiliary artefacts it can emit or derive, which simulator-side inputs it requires, and the container image ANDREA uses to execute it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "publication",
    "first_author",
    "year",
    "simulation_summary",
    "simulation_keywords",
    "implementation_url",
    "docker_image",
    "extra_inputs",
    "compatibility_rules",
    "runtime_resources",
    "profile_capabilities",
    "params"
  ],
  "$defs": {
    "canonical_profile": {
      "type": "string",
      "enum": [
        "bulk_steady_state",
        "bulk_time_series",
        "bulk_perturbational",
        "scrna_global",
        "scrna_grouped",
        "scrna_cell_specific"
      ]
    },
    "extra_key": {
      "type": "string",
      "enum": [
        "groups",
        "cell_phenotypes",
        "cluster_identities",
        "enrichment_background",
        "lineage_tree",
        "pseudotime",
        "prior_grn",
        "tf_list",
        "prior_grn_by_group"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "extra_input_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "usage"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/identifier"
        },
        "usage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditional_input_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(profile|requested_extra|native_output|param\\.[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*)$"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "value": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "integer" },
                  { "type": "number" },
                  { "type": "boolean" },
                  { "type": "string" }
                ]
              }
            }
          ]
        }
      }
    },
    "conditional_input_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "usage",
        "conditions",
        "message"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/identifier"
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditional_input_condition"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibility_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(profile|requested_extra|native_output|param\\.[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*|input\\.[a-z][a-z0-9_]*\\.unique_gene_count)$"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "value": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "integer" },
                  { "type": "number" },
                  { "type": "boolean" },
                  { "type": "string" }
                ]
              }
            }
          ]
        },
        "value_from": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(param\\.[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*|input\\.[a-z][a-z0-9_]*\\.unique_gene_count)$"
        }
      },
      "oneOf": [
        { "required": ["value"], "not": { "required": ["value_from"] } },
        { "required": ["value_from"], "not": { "required": ["value"] } }
      ]
    },
    "compatibility_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "conditions",
        "message"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["block", "warn"]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/compatibility_condition"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extra_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional",
        "conditional_required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extra_input_usage"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extra_input_usage"
          }
        },
        "conditional_required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditional_input_requirement"
          }
        }
      }
    },
    "runtime_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threading"],
      "properties": {
        "threading": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "default_threads",
            "max_threads",
            "upstream_mapping"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "default_threads": {
              "type": "integer",
              "minimum": 1
            },
            "max_threads": {
              "type": "integer",
              "minimum": 1
            },
            "upstream_mapping": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "truth_output_mode": {
      "type": "string",
      "enum": [
        "none",
        "native",
        "derivable"
      ]
    },
    "truth_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global",
        "group",
        "cell"
      ],
      "properties": {
        "global": {
          "$ref": "#/$defs/truth_output_mode"
        },
        "group": {
          "$ref": "#/$defs/truth_output_mode"
        },
        "cell": {
          "$ref": "#/$defs/truth_output_mode"
        }
      }
    },
    "truth_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "status"
      ],
      "properties": {
        "context": {
          "type": "string",
          "enum": [
            "global",
            "group",
            "cell"
          ]
        },
        "status": {
          "$ref": "#/$defs/truth_output_mode"
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "upstream_configuration": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "score_semantics": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["native", "derivable"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": [
              "source_artifacts",
              "upstream_configuration",
              "generation",
              "score_semantics",
              "limitations"
            ]
          }
        }
      ]
    },
    "truth_parameter_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_output",
        "conditions",
        "message"
      ],
      "properties": {
        "truth_output": {
          "type": "string",
          "enum": [
            "global",
            "group",
            "cell"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditional_input_condition"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "derivable_artifact_key": {
      "type": "string",
      "enum": [
        "groups",
        "cell_phenotypes",
        "cluster_identities",
        "enrichment_background",
        "lineage_tree",
        "pseudotime",
        "prior_grn",
        "tf_list",
        "prior_grn_by_group",
        "global",
        "group",
        "cell"
      ]
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "source_artifacts",
        "method",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/derivable_artifact_key"
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implemented_in": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aux_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "matrix",
            "graph",
            "counts",
            "metadata",
            "directory",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "native_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "formats"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "matrix",
            "graph",
            "counts",
            "metadata",
            "directory",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditional_input_condition"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_extras",
        "derivable_extras",
        "truth_outputs",
        "derivations",
        "native_outputs",
        "artifacts_aux"
      ],
      "properties": {
        "native_extras": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extra_key"
          }
        },
        "derivable_extras": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extra_key"
          }
        },
        "truth_outputs": {
          "$ref": "#/$defs/truth_outputs"
        },
        "truth_contexts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/truth_context"
          }
        },
        "truth_parameter_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/truth_parameter_requirement"
          }
        },
        "derivations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/derivation"
          }
        },
        "native_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_output"
          }
        },
        "artifacts_aux": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aux_artifact"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "param_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required",
        "default",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "int",
            "float",
            "bool",
            "string",
            "enum",
            "object",
            "array",
            "union"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "string" },
            { "type": "array" },
            { "type": "object" }
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "min": {
          "type": "number"
        },
        "exclusive_min": {
          "type": "boolean"
        },
        "max": {
          "type": "number"
        },
        "exclusive_max": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/param_def"
          }
        },
        "items": {
          "$ref": "#/$defs/param_def"
        },
        "oneOf": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/param_def"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "enum" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["enum"]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "array" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["items"]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "union" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["oneOf"]
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "first_author": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "simulation_summary": {
      "type": "string",
      "minLength": 1
    },
    "simulation_keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "implementation_url": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "docker_image": {
      "type": "string",
      "minLength": 1
    },
    "extra_inputs": {
      "$ref": "#/$defs/extra_inputs"
    },
    "compatibility_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibility_rule"
      }
    },
    "runtime_resources": {
      "$ref": "#/$defs/runtime_resources"
    },
    "profile_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "bulk_steady_state": {
          "$ref": "#/$defs/profile_capability"
        },
        "bulk_time_series": {
          "$ref": "#/$defs/profile_capability"
        },
        "bulk_perturbational": {
          "$ref": "#/$defs/profile_capability"
        },
        "scrna_global": {
          "$ref": "#/$defs/profile_capability"
        },
        "scrna_grouped": {
          "$ref": "#/$defs/profile_capability"
        },
        "scrna_cell_specific": {
          "$ref": "#/$defs/profile_capability"
        }
      }
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/param_def"
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
