{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/simulator-spec.schema.json",
  "title": "ANDREA SimulatorSpec",
  "description": "Operational and scientific schema for benchmark data simulators used by generate-data. This schema describes what a simulator can model, which auxiliary artefacts it can emit or derive, which simulator-side inputs it requires, and the container image ANDREA uses to execute it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "publication",
    "first_author",
    "year",
    "simulation_summary",
    "simulation_keywords",
    "implementation_url",
    "docker_image",
    "extra_inputs",
    "compatibility_rules",
    "runtime_resources",
    "params",
    "capabilities"
  ],
  "$defs": {
    "extra_key": {
      "type": "string",
      "enum": [
        "groups",
        "column_descriptors",
        "column_phenotypes",
        "cluster_identities",
        "enrichment_background",
        "interventions",
        "lineage_tree",
        "perturbation_design",
        "pseudotime",
        "prior_grn",
        "prior_grn_by_group",
        "replicates",
        "tf_list",
        "timepoints",
        "spatial_coordinates",
        "chromatin_accessibility",
        "chromatin_regions",
        "cell_cell_interactions"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "extra_input_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "usage"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/identifier"
        },
        "usage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conditional_input_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(data_axes\\.(measurement|resolution|column_kind|experimental_design)|truth_requirement|requested_extra|native_output|param\\.[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*)$"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "conditional_input_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "usage",
        "conditions",
        "message"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/identifier"
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditional_input_condition"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibility_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(data_axes\\.(measurement|resolution|column_kind|experimental_design)|truth_requirement|requested_extra|native_output|param\\.[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*|input\\.[a-z][a-z0-9_]*\\.unique_gene_count)$"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          ]
        },
        "value_from": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(param\\.[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*|input\\.[a-z][a-z0-9_]*\\.unique_gene_count)$"
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "value_from"
            ]
          }
        },
        {
          "required": [
            "value_from"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "compatibility_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "conditions",
        "message"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "scenario_and_run",
            "run"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "block",
            "warn"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/compatibility_condition"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extra_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional",
        "conditional_required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extra_input_usage"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extra_input_usage"
          }
        },
        "conditional_required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditional_input_requirement"
          }
        }
      }
    },
    "runtime_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threading"
      ],
      "properties": {
        "threading": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "default_threads",
            "max_threads",
            "upstream_mapping"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "default_threads": {
              "type": "integer",
              "minimum": 1
            },
            "max_threads": {
              "type": "integer",
              "minimum": 1
            },
            "upstream_mapping": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "truth_output_mode": {
      "type": "string",
      "enum": [
        "none",
        "native",
        "derivable"
      ]
    },
    "truth_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/truth_output"
      }
    },
    "truth_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "status"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/truth_context_family"
        },
        "status": {
          "$ref": "#/$defs/truth_output_mode"
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "upstream_configuration": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "score_semantics": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "native",
                  "derivable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "source_artifacts",
              "upstream_configuration",
              "generation",
              "score_semantics",
              "limitations"
            ]
          }
        }
      ]
    },
    "truth_parameter_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_output",
        "conditions",
        "message"
      ],
      "properties": {
        "truth_output": {
          "$ref": "#/$defs/truth_context_family"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditional_input_condition"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "param",
        "policy",
        "value"
      ],
      "properties": {
        "param": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
        },
        "policy": {
          "type": "string",
          "enum": [
            "locked",
            "default_if_unset"
          ]
        },
        "value": true,
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": true
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^data_axes\\.(measurement|resolution|column_kind|experimental_design)$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "derivable_artifact_key": {
      "type": "string",
      "enum": [
        "groups",
        "column_descriptors",
        "column_phenotypes",
        "cluster_identities",
        "enrichment_background",
        "interventions",
        "lineage_tree",
        "perturbation_design",
        "pseudotime",
        "prior_grn",
        "prior_grn_by_group",
        "replicates",
        "tf_list",
        "timepoints",
        "global",
        "group",
        "column",
        "spatial_coordinates",
        "chromatin_accessibility",
        "chromatin_regions",
        "cell_cell_interactions"
      ]
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "source_artifacts",
        "method",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/derivable_artifact_key"
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implemented_in": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aux_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "matrix",
            "graph",
            "counts",
            "metadata",
            "directory",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "native_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "formats"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "matrix",
            "graph",
            "counts",
            "metadata",
            "directory",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conditional_input_condition"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "param_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required",
        "default",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "int",
            "float",
            "bool",
            "string",
            "enum",
            "object",
            "array",
            "union"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array"
            },
            {
              "type": "object"
            }
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "min": {
          "type": "number"
        },
        "exclusive_min": {
          "type": "boolean"
        },
        "max": {
          "type": "number"
        },
        "exclusive_max": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/param_def"
          }
        },
        "items": {
          "$ref": "#/$defs/param_def"
        },
        "oneOf": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/param_def"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enum"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "union"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "oneOf"
            ]
          }
        }
      ]
    },
    "data_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "resolution",
        "column_kind",
        "experimental_design"
      ],
      "properties": {
        "measurement": {
          "type": "string",
          "enum": [
            "rna_expression"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "bulk",
            "single_cell",
            "spatial",
            "pseudo_bulk",
            "mixed",
            "unknown"
          ]
        },
        "column_kind": {
          "type": "string",
          "enum": [
            "samples",
            "cells",
            "timepoints",
            "perturbations",
            "spots",
            "metacells",
            "conditions"
          ]
        },
        "experimental_design": {
          "type": "string",
          "enum": [
            "observational",
            "steady_state",
            "perturbational",
            "time_series",
            "trajectory",
            "differentiation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "cells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "single_cell"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "spots"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "const": "spatial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_kind": {
                "const": "metacells"
              }
            },
            "required": [
              "column_kind"
            ]
          },
          "then": {
            "properties": {
              "resolution": {
                "enum": [
                  "single_cell",
                  "pseudo_bulk"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "time_series"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "timepoints",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "experimental_design": {
                "const": "perturbational"
              }
            },
            "required": [
              "experimental_design"
            ]
          },
          "then": {
            "properties": {
              "column_kind": {
                "enum": [
                  "perturbations",
                  "cells",
                  "samples"
                ]
              }
            }
          }
        }
      ]
    },
    "truth_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "global",
              "group",
              "column"
            ]
          },
          "contains": {
            "const": "global"
          }
        }
      }
    },
    "semantic_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_axes",
        "truth_requirements",
        "native_extras",
        "derivable_extras",
        "truth_outputs",
        "truth_contexts",
        "derivations",
        "native_outputs",
        "artifacts_aux"
      ],
      "properties": {
        "data_axes": {
          "$ref": "#/$defs/data_axes"
        },
        "truth_requirements": {
          "$ref": "#/$defs/truth_requirements"
        },
        "native_extras": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extra_key"
          }
        },
        "derivable_extras": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extra_key"
          }
        },
        "truth_outputs": {
          "$ref": "#/$defs/truth_outputs"
        },
        "truth_contexts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/truth_context"
          }
        },
        "truth_parameter_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/truth_parameter_requirement"
          }
        },
        "parameter_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_binding"
          }
        },
        "derivations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/derivation"
          }
        },
        "native_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_output"
          }
        },
        "artifacts_aux": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aux_artifact"
          }
        }
      }
    },
    "truth_context_family": {
      "type": "string",
      "enum": [
        "global",
        "group",
        "column"
      ]
    },
    "truth_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "status"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/truth_context_family"
        },
        "status": {
          "type": "string",
          "enum": [
            "native",
            "derivable"
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "first_author": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "simulation_summary": {
      "type": "string",
      "minLength": 1
    },
    "simulation_keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "implementation_url": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "docker_image": {
      "type": "string",
      "minLength": 1
    },
    "extra_inputs": {
      "$ref": "#/$defs/extra_inputs"
    },
    "compatibility_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibility_rule"
      }
    },
    "runtime_resources": {
      "$ref": "#/$defs/runtime_resources"
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/param_def"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/semantic_capability"
      }
    }
  }
}
