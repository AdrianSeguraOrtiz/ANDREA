{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.org/schemas/tool-spec.schema.json",
  "title": "ANDREA ToolSpec",
  "description": "Minimal tool annotation schema for GRN inference tools (compatibility, outputs, priors, provenance, extra inputs and parameter signature). All fields are required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "publication",
    "first_author",
    "year",
    "method_summary",
    "method_keywords",
    "implementation_url",
    "docker_image",
    "execution_capabilities",
    "runtime_resources",
    "taxonomic_scope",
    "compatibility_rules",
    "accepts",
    "assumes",
    "extra_inputs",
    "artifacts_aux",
    "outputs",
    "progress",
    "params"
  ],
  "$defs": {
    "input_key": {
      "type": "string",
      "enum": [
        "groups",
        "column_descriptors",
        "column_phenotypes",
        "cluster_identities",
        "cluster_markers",
        "enrichment_background",
        "grnboost_network",
        "interventions",
        "lineage_tree",
        "perturbation_design",
        "pseudotime",
        "prior_grn",
        "prior_grn_by_group",
        "replicates",
        "spatial_coordinates",
        "terms_of_interest",
        "tf_list",
        "timepoints",
        "chromatin_accessibility",
        "chromatin_regions",
        "cell_cell_interactions"
      ]
    },
    "taxonomic_group": {
      "type": "string",
      "enum": [
        "animal",
        "plant",
        "fungi",
        "bacteria",
        "archaea",
        "protist",
        "viral",
        "synthetic",
        "unknown"
      ]
    },
    "runtime_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threading"
      ],
      "properties": {
        "threading": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "default_threads",
            "max_threads",
            "upstream_mapping"
          ],
          "properties": {
            "supported": {
              "type": "boolean",
              "description": "Whether ANDREA may assign more than one runtime thread to this tool."
            },
            "default_threads": {
              "type": "integer",
              "minimum": 1,
              "description": "Default planner thread assignment when no cost profile is available."
            },
            "max_threads": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum planner thread assignment supported by the wrapper/upstream runtime."
            },
            "upstream_mapping": {
              "type": "string",
              "minLength": 1,
              "description": "How wrapper --threads maps to upstream API, CLI, worker, process or runtime environment controls."
            }
          }
        }
      }
    },
    "extra_input_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "usage"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/input_key"
        },
        "usage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op"
      ],
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "value_from"
            ]
          }
        },
        {
          "required": [
            "value_from"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(dataset\\.organism\\.(taxonomic_group|ncbi_taxon_id)|param\\.[a-zA-Z_][a-zA-Z0-9_]*|execution\\.mode)$"
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array"
            }
          ]
        },
        "value_from": {
          "type": "string",
          "enum": [
            "taxonomic_scope.supported_species"
          ]
        }
      }
    },
    "param_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required",
        "default",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "int",
            "float",
            "bool",
            "string",
            "enum",
            "object",
            "array",
            "union"
          ],
          "description": "Parameter value type."
        },
        "required": {
          "type": "boolean",
          "description": "Whether the user must provide this parameter (true) or it can be omitted (false)."
        },
        "default": {
          "description": "Default value for this parameter. Use null if there is no default / must be provided.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "array"
            },
            {
              "type": "object"
            }
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Allowed values when type=enum."
        },
        "min": {
          "type": "number",
          "description": "Minimum value (for int/float)."
        },
        "exclusive_min": {
          "type": "boolean",
          "description": "Whether the minimum bound is exclusive (for int/float)."
        },
        "max": {
          "type": "number",
          "description": "Maximum value (for int/float)."
        },
        "exclusive_max": {
          "type": "boolean",
          "description": "Whether the maximum bound is exclusive (for int/float)."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Short human-readable description."
        },
        "properties": {
          "type": "object",
          "description": "Nested object fields when type=object.",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/param_def"
          }
        },
        "items": {
          "$ref": "#/$defs/param_def",
          "description": "Array element definition when type=array."
        },
        "oneOf": {
          "type": "array",
          "minItems": 2,
          "description": "Union/overloaded parameter definition when type=union (e.g., string OR int OR float).",
          "items": {
            "$ref": "#/$defs/param_def"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enum"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "union"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "oneOf"
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "ToolSpec schema version."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Stable tool identifier (lowercase, digits, underscore, hyphen)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable tool name."
    },
    "publication": {
      "description": "Scientific origin reference(s) (e.g., DOI(s), bib entry key(s), or citation string(s)).",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "first_author": {
      "type": "string",
      "minLength": 1,
      "description": "First author name for the primary publication shown in 'publication'."
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100,
      "description": "Publication year of the primary method paper shown first in 'publication'."
    },
    "method_summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short 1-2 sentence summary of the tool's methodological core."
    },
    "method_keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9_]+$"
      },
      "description": "Lowercase snake_case keywords summarizing the method family or core modeling ideas."
    },
    "implementation_url": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "description": "URL to the implementation used (e.g., PyPI, GitHub repository, Bioconductor, etc.)."
    },
    "docker_image": {
      "type": "string",
      "minLength": 1,
      "description": "Docker image name/tag generated by you (e.g., ghcr.io/user/tool:version)."
    },
    "execution_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "global",
          "group_native",
          "group_emulated",
          "column_native",
          "group_aggregated"
        ]
      },
      "description": "Execution modes supported by the tool wrapper: global, native grouped inference, orchestrator-emulated grouped inference, native per-column inference, and/or ANDREA group aggregation from native per-column outputs."
    },
    "runtime_resources": {
      "$ref": "#/$defs/runtime_resources"
    },
    "taxonomic_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_groups",
        "supported_species"
      ],
      "properties": {
        "allowed_groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taxonomic_group"
          },
          "description": "Broad taxonomic groups accepted by this tool before parameter-specific compatibility rules are evaluated."
        },
        "supported_species": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Optional NCBI Taxonomy IDs with explicit species-level support. Empty means no species-level restriction is declared."
        }
      }
    },
    "compatibility_rules": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conditions",
          "action",
          "message"
        ],
        "properties": {
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/condition"
            },
            "description": "AND-combined conditions evaluated against dataset, resolved params and resolved execution."
          },
          "action": {
            "type": "string",
            "enum": [
              "block",
              "warn"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "General compatibility rules evaluated after dataset, parameter defaults/overrides, and execution mode are known."
    },
    "accepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "samples",
          "cells",
          "timepoints",
          "perturbations",
          "spots",
          "metacells",
          "conditions"
        ]
      },
      "description": "Column kinds the tool can be applied to."
    },
    "assumes": {
      "type": "string",
      "enum": [
        "scrna_specific",
        "bulk_specific",
        "generic"
      ],
      "description": "Domain assumption: scRNA-specific, bulk-specific, or generic (works for both)."
    },
    "extra_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "description": "Additional input artefacts (besides expression matrix) that the tool may consume. The orchestrator mounts them under /io/extra/.",
      "properties": {
        "required": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/extra_input_usage"
          },
          "description": "Extra artefacts that MUST be provided for the tool to run."
        },
        "optional": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/extra_input_usage"
          },
          "description": "Extra artefacts that MAY be provided to enrich or modify inference without being required by the selected configuration."
        },
        "conditional_required": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "op",
              "value",
              "usage",
              "message"
            ],
            "oneOf": [
              {
                "required": [
                  "param"
                ],
                "not": {
                  "required": [
                    "execution"
                  ]
                }
              },
              {
                "required": [
                  "execution"
                ],
                "not": {
                  "required": [
                    "param"
                  ]
                }
              }
            ],
            "properties": {
              "input": {
                "$ref": "#/$defs/input_key"
              },
              "param": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              },
              "execution": {
                "type": "string",
                "enum": [
                  "mode"
                ]
              },
              "op": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "in",
                  "not_in",
                  "gt",
                  "gte",
                  "lt",
                  "lte"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Extra artefacts that become required only when specific parameter or execution-mode values activate a certain tool mode."
        }
      }
    },
    "artifacts_aux": {
      "type": "array",
      "description": "Auxiliary files/directories generated in output-dir in addition to network.csv and progress.json.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_pattern",
          "kind"
        ],
        "properties": {
          "path_pattern": {
            "type": "string",
            "minLength": 1,
            "description": "Glob pattern relative to output-dir (e.g., 'aracne3.stdout.log' or 'consolidated-net_*.tsv')."
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "dir"
            ],
            "description": "Expected artifact type."
          },
          "require_non_empty": {
            "type": "boolean",
            "description": "If true, smoketests must verify the artifact has content."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable artifact description."
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directed",
        "sign",
        "evidence"
      ],
      "properties": {
        "directed": {
          "type": "boolean",
          "description": "Whether the output edges are directed."
        },
        "sign": {
          "type": "string",
          "enum": [
            "none",
            "signed",
            "mixed"
          ],
          "description": "Sign support in outputs: none, signed (always), mixed (sometimes/partial)."
        },
        "evidence": {
          "type": "string",
          "enum": [
            "association",
            "causal",
            "pseudotime_directed"
          ],
          "description": "Primary evidence type produced by the tool."
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "Progress reporting contract exposed by the tool during execution.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "task_partitions",
            "target_genes",
            "iterations"
          ],
          "description": "Semantic unit used to compute progress percentage."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable clarification about progress semantics."
        }
      }
    },
    "params": {
      "type": "object",
      "description": "Tool parameter signature (definitions), not execution values. Use an empty object {} if the tool has no parameters.",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/param_def"
      }
    }
  }
}
