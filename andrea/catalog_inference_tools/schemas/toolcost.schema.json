{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.org/schemas/tool-cost.schema.json",
  "title": "ANDREA Tool Cost Profiles",
  "description": "Empirical benchmark-derived runtime/cost profiles for a tool. Stored in andrea/catalog_inference_tools/tools/<tool_id>/cost.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version. Kept at 1.0 while the platform is pre-release."
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "description": "Empirical runtime profiles for relevant execution/input/parameter combinations.",
      "items": {
        "$ref": "#/$defs/cost_profile"
      }
    }
  },
  "$defs": {
    "cost_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "benchmark_config",
        "runtime_points"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "description": "Stable identifier for this execution/input/parameter cost profile."
        },
        "benchmark_config": {
          "$ref": "#/$defs/benchmark_config"
        },
        "runtime_points": {
          "$ref": "#/$defs/runtime_points"
        }
      }
    },
    "benchmark_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizes",
        "threads_tested",
        "ram_gb_tested",
        "repeats",
        "timeout_seconds",
        "execution_profile",
        "input_profile",
        "params_profile"
      ],
      "description": "Benchmark matrix configuration used to generate one cost profile.",
      "properties": {
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/size_point"
          },
          "description": "Input size points used in the benchmark."
        },
        "threads_tested": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Thread counts tested."
        },
        "ram_gb_tested": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "RAM limits (GB) tested."
        },
        "repeats": {
          "type": "integer",
          "minimum": 1,
          "description": "Configured repeats per benchmark point."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Configured timeout per run in seconds."
        },
        "execution_profile": {
          "$ref": "#/$defs/execution_profile"
        },
        "input_profile": {
          "$ref": "#/$defs/input_profile"
        },
        "params_profile": {
          "$ref": "#/$defs/params_profile"
        }
      }
    },
    "size_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genes",
        "columns"
      ],
      "properties": {
        "genes": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "physical_task_policy",
        "group_count"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1,
          "description": "Logical execution mode. Must be one of the tool's execution_capabilities."
        },
        "physical_task_policy": {
          "type": "string",
          "enum": [
            "single",
            "native_grouped",
            "andrea_group_emulated",
            "column_native",
            "andrea_group_aggregated"
          ],
          "description": "How the logical run maps to physical wrapper/container tasks."
        },
        "group_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of groups represented by this profile; must be 0 for global profiles."
        },
        "aggregation_step": {
          "type": "string",
          "enum": ["none", "column_to_group"],
          "description": "Deterministic ANDREA post-processing step represented by this profile, if any."
        }
      }
    },
    "input_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column_kind",
        "expression_profile",
        "extras_provided",
        "required_inputs_satisfied",
        "optional_inputs_provided",
        "conditional_inputs_satisfied",
        "tf_count_policy",
        "prior_density",
        "group_count",
        "notes"
      ],
      "properties": {
        "column_kind": {
          "type": "string",
          "minLength": 1,
          "description": "Column semantics used by the benchmark input matrix."
        },
        "expression_profile": {
          "type": "string",
          "minLength": 1,
          "description": "Expression data profile used by the benchmark fixture generator."
        },
        "extras_provided": {
          "$ref": "#/$defs/input_key_array"
        },
        "required_inputs_satisfied": {
          "$ref": "#/$defs/input_key_array"
        },
        "optional_inputs_provided": {
          "$ref": "#/$defs/input_key_array"
        },
        "conditional_inputs_satisfied": {
          "$ref": "#/$defs/input_key_array"
        },
        "tf_count_policy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Policy used to choose candidate TF count, when relevant."
        },
        "prior_density": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Prior GRN density used by the benchmark input generator, when relevant."
        },
        "group_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of groups represented in grouped extra inputs."
        },
        "has_tf_list": {
          "type": "boolean",
          "description": "Whether the benchmark input profile includes the standardized tf_list extra."
        },
        "output_density_class": {
          "type": "string",
          "enum": ["sparse", "dense", "unknown"],
          "description": "Expected output density class for this benchmark profile."
        },
        "aggregation_step": {
          "type": "string",
          "enum": ["none", "column_to_group"],
          "description": "Post-processing aggregation step attached to this benchmark profile."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Short notes about profile limitations or fixture generation choices."
        }
      }
    },
    "input_key_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "params_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "override_file",
        "resolved_params",
        "cost_relevant_params",
        "cost_relevant_values"
      ],
      "description": "Resolved parameter profile used during benchmarking, derived from ToolSpec defaults plus an optional dev override.",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "toolspec_defaults",
            "toolspec_defaults_plus_override"
          ]
        },
        "override_file": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "resolved_params": {
          "type": "object",
          "description": "Concrete params.json payload passed to the wrapper during the benchmark."
        },
        "cost_relevant_params": {
          "type": "array",
          "uniqueItems": true,
          "description": "Dotted resolved parameter paths that materially affect runtime/cost profile matching.",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
          }
        },
        "cost_relevant_values": {
          "type": "object",
          "description": "Flattened values for cost_relevant_params, keyed by dotted parameter path.",
          "additionalProperties": true
        }
      }
    },
    "runtime_points": {
      "type": "array",
      "minItems": 1,
      "description": "Empirical runtime and failure profile by size and resource configuration.",
      "items": {
        "$ref": "#/$defs/runtime_point"
      }
    },
    "runtime_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genes",
        "columns",
        "threads",
        "ram_gb",
        "status",
        "repeats_total",
        "repeats_ok",
        "repeats_failed",
        "ok_rate",
        "failure_breakdown",
        "seconds_p50",
        "seconds_p90"
      ],
      "properties": {
        "genes": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of genes (rows)."
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of columns (samples/cells/timepoints/perturbations)."
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "description": "Thread count used for this benchmark point."
        },
        "ram_gb": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Container memory limit (GB) used for this benchmark point."
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "partial",
            "oom",
            "timeout",
            "error"
          ],
          "description": "Aggregated run status for this point."
        },
        "repeats_total": {
          "type": "integer",
          "minimum": 1,
          "description": "Total repeats attempted for this point."
        },
        "repeats_ok": {
          "type": "integer",
          "minimum": 0,
          "description": "Successful repeats for this point."
        },
        "repeats_failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Failed repeats for this point."
        },
        "ok_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ratio repeats_ok / repeats_total."
        },
        "failure_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oom",
            "timeout",
            "error"
          ],
          "properties": {
            "oom": {
              "type": "integer",
              "minimum": 0
            },
            "timeout": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Failure counts by category across repeats for this point."
        },
        "seconds_p50": {
          "description": "Median runtime over successful repeats; null when repeats_ok=0.",
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "seconds_p90": {
          "description": "Approximate p90 runtime over successful repeats; null when repeats_ok=0.",
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "feature_vector": {
          "type": "object",
          "additionalProperties": true,
          "description": "Resolved cost features for this benchmark point, including execution mode, dimensions, expected context count, expected dense edge upper bound and extra-input flags."
        }
      }
    }
  }
}
