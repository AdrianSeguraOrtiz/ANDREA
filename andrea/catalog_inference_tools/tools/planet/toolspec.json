{
  "schema_version": "1.0",
  "id": "planet",
  "name": "Planet",
  "publication": [
    "https://doi.org/10.3390/genes16111255"
  ],
  "first_author": "Shiyu Xu",
  "year": 2025,
  "method_summary": "Planet is an attention-guided probabilistic diffusion framework for constructing cell-specific gene regulatory networks from gene expression profiles. It models directed TF-to-target edges as binary graph states, uses a Triple Hybrid-Attention Transformer during reverse diffusion, and aggregates repeated generations into edge-level confidence.",
  "method_keywords": [
    "single_cell",
    "diffusion_model",
    "probabilistic_generation",
    "hybrid_attention",
    "graph_attention",
    "metacell",
    "cell_specific_network",
    "directed"
  ],
  "implementation_url": "https://github.com/wangchuanyuan1/project-Planet/tree/3d8be3ca788dc436e8d2c888facdeffe49553c61",
  "docker_image": "adriansegura99/inference-tools_planet:1.0.0",
  "execution_capabilities": [
    "global",
    "group_emulated"
  ],
  "runtime_resources": {
    "threading": {
      "supported": true,
      "default_threads": 1,
      "max_threads": 8,
      "upstream_mapping": "Wrapper --threads maps to Planet args.n_job=min(threads, ensemble) for the joblib Parallel(n_jobs=n_job) ensemble execution in Planet.test(). The wrapper pins PyTorch and common BLAS/OpenMP intra-process thread counts to 1 so joblib workers run independent diffusion ensemble members without nested oversubscription."
    }
  },
  "taxonomic_scope": {
    "allowed_groups": [
      "animal"
    ],
    "supported_species": [
      9606
    ]
  },
  "compatibility_rules": [
    {
      "conditions": [
        {
          "field": "dataset.organism.ncbi_taxon_id",
          "op": "ne",
          "value": null
        },
        {
          "field": "dataset.organism.ncbi_taxon_id",
          "op": "not_in",
          "value_from": "taxonomic_scope.supported_species"
        }
      ],
      "action": "block",
      "message": "Planet's selected CSV/pathway inference contract uses bundled human TF, KEGG and RegNetwork resources; only Homo sapiens datasets are supported when a dataset NCBI taxon id is declared."
    },
    {
      "conditions": [
        {
          "field": "param.gene_set",
          "op": "eq",
          "value": "all_expression_genes"
        },
        {
          "field": "dataset.expression.genes",
          "op": "gt",
          "value": 99
        }
      ],
      "action": "block",
      "message": "Planet's bundled pretrained checkpoint supports at most 99 selected genes. gene_set=all_expression_genes selects every expression gene, so use a dataset with 99 or fewer genes or choose a KEGG pathway whose intersection with the expression matrix retains 10 to 99 human genes."
    }
  ],
  "accepts": [
    "cells"
  ],
  "assumes": "scrna_specific",
  "extra_inputs": {
    "required": [],
    "optional": [],
    "conditional_required": [
      {
        "input": "groups",
        "execution": "mode",
        "op": "eq",
        "value": "group_emulated",
        "message": "groups is required when execution.mode=group_emulated because ANDREA partitions the dataset by group before running Planet independently per group.",
        "usage": "ANDREA uses groups.tsv to create one Planet child run per group; each child receives that group's expression matrix and Planet itself does not consume groups.tsv."
      }
    ]
  },
  "artifacts_aux": [
    {
      "path_pattern": "planet.log",
      "kind": "file",
      "require_non_empty": true,
      "description": "Combined wrapper and upstream Planet stdout/stderr log."
    },
    {
      "path_pattern": "raw/adj_final.csv",
      "kind": "file",
      "require_non_empty": true,
      "description": "Raw Planet final directed adjacency/vote matrix returned by cal_final_net() before conversion to ANDREA network.csv."
    },
    {
      "path_pattern": "raw/planet_config.json",
      "kind": "file",
      "require_non_empty": true,
      "description": "Resolved Planet parameters, selected gene set, resource files, checkpoint, expression dimensions and runtime thread mapping."
    },
    {
      "path_pattern": "raw/selected_genes.tsv",
      "kind": "file",
      "require_non_empty": true,
      "description": "Gene identifiers retained by Planet after applying the selected KEGG pathway or wrapper-generated all-expression-gene set."
    }
  ],
  "outputs": {
    "directed": true,
    "sign": "none",
    "evidence": "association"
  },
  "progress": {
    "kind": "none",
    "note": "The selected public API runs preprocessing and then Planet.test() executes independent reverse-diffusion ensemble members. It does not expose a stable progress callback; the wrapper reports coarse lifecycle states in progress.json and preserves upstream diagnostics in planet.log."
  },
