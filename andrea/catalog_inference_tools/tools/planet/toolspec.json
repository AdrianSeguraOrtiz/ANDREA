    "metacell": {
      "type": "bool",
      "required": false,
      "default": true,
      "description": "Whether to use upstream metacell preprocessing before Planet inference. Upstream Config.metacell defaults to true."
    },
    "knn": {
      "type": "int",
      "required": false,
      "default": 20,
      "min": 1,
      "description": "K nearest-neighbor value passed to upstream args.KNN for metacell construction. When metacell=true, the wrapper requires knn to be no greater than the number of expression columns."
    },
    "metacell_count": {
      "type": "int",
      "required": false,
      "default": 100,
      "min": 1,
      "description": "Number of metacells passed to upstream args.Cnum. If the number of expression columns is less than or equal to this value, upstream cal_metacell() returns the original columns."
    },
    "ensemble": {
      "type": "int",
      "required": false,
      "default": 30,
      "min": 1,
      "description": "Number of independent reverse-diffusion ensemble generations passed to upstream args.ensemble. Raw network.csv scores preserve the summed positive vote counts returned by cal_final_net(), not score/ensemble normalization. Runtime scales with this value; choose a smaller value when the available runtime budget is limited."
    },
    "diffusion_timesteps": {
      "type": "int",
      "required": false,
      "default": 1000,
      "min": 1,
      "description": "Total diffusion time steps passed to upstream args.diffusion_timesteps. Upstream Config defaults to 1000. Runtime scales with this value; choose a smaller value when the available runtime budget is limited."
    },
    "sampling_timesteps": {
      "type": "int",
      "required": false,
      "default": 1000,
      "min": 1,
      "description": "Reverse sampling steps passed to upstream args.sampling_timesteps. The Planet paper describes accelerated sampling by reducing the sampling path from 1000 steps to 500 or fewer while preserving generation quality. Keep this value no larger than diffusion_timesteps; runtime scales with this value."
    }
  }
