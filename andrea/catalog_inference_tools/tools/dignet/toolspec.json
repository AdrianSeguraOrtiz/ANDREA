    "metacell": {
      "type": "bool",
      "required": false,
      "default": true,
      "description": "Whether to use DigNet's meta-cell preprocessing before inference. The bundled pretrained CSV/PCA model used by this wrapper requires each invocation to produce exactly 100 expression features after this preprocessing step."
    },
    "knn": {
      "type": "int",
      "required": false,
      "default": 20,
      "min": 1,
      "description": "K nearest-neighbor parameter used by DigNet meta-cell construction when metacell=true; the wrapper must require knn <= number of input cells."
    },
    "metacell_count": {
      "type": "int",
      "required": false,
      "default": 100,
      "min": 1,
      "description": "Cnum meta-cell count passed to DigNet's cal_metacell() when metacell=true. If the number of input cells is less than or equal to this value, upstream returns the original expression columns after neighbor calculation. The wrapper validates that the effective feature count is 100 to match the bundled S33_Cancer_cell_pca_model.pkl."
    },
    "ensemble": {
      "type": "int",
      "required": false,
      "default": 30,
      "min": 1,
      "description": "Number of independent DigNet diffusion generations aggregated by cal_final_net(); raw output scores are vote counts from 1 to ensemble."
    },
    "diffusion_timesteps": {
      "type": "int",
      "required": false,
      "default": 1000,
      "min": 1,
      "description": "Number of reverse diffusion timesteps used by GaussianDiffusion1D during DigNet test generation."
    }
  }
}
