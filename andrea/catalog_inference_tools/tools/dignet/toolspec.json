{
  "schema_version": "1.0",
  "id": "dignet",
  "name": "DigNet",
  "publication": [
    "https://doi.org/10.1101/gr.279551.124"
  ],
  "first_author": "Chuanyuan Wang",
  "year": 2024,
  "method_summary": "DigNet generates gene regulatory networks from scRNA-seq expression profiles with a discrete diffusion generative model and graph-transformer denoising in non-Euclidean graph space. The method models GRN edges as binary on/off states, uses meta-cell integration for noisy scRNA-seq profiles, and aggregates repeated diffusion generations into a final directed network.",
  "method_keywords": [
    "single_cell",
    "diffusion_model",
    "discrete_generation",
    "graph_transformer",
    "metacell",
    "cell_specific_network",
    "directed"
  ],
  "implementation_url": "https://github.com/zpliulab/DigNet",
  "docker_image": "adriansegura99/inference-tools_dignet:1.0.0",
  "execution_capabilities": [
    "global",
    "group_emulated"
  ],
  "runtime_resources": {
    "threading": {
      "supported": true,
      "default_threads": 1,
      "max_threads": 8,
      "upstream_mapping": "The wrapper maps ANDREA --threads to DigNet args.n_job=min(threads, ensemble) for the joblib Parallel(n_jobs=n_job) ensemble execution in DigNet.test(). The wrapper also keeps PyTorch and BLAS/OpenMP intra-process thread counts at 1 to avoid nested oversubscription while joblib runs independent diffusion ensemble members."
    }
  },
  "taxonomic_scope": {
    "allowed_groups": [
      "animal"
    ],
    "supported_species": [
      9606
    ]
  },
  "compatibility_rules": [
    {
      "conditions": [
        {
          "field": "dataset.organism.ncbi_taxon_id",
          "op": "ne",
          "value": null
        },
        {
          "field": "dataset.organism.ncbi_taxon_id",
          "op": "not_in",
          "value_from": "taxonomic_scope.supported_species"
        }
      ],
      "action": "block",
      "message": "DigNet's selected CSV/pathway inference path uses human KEGG, human RegNetwork and human TF resources; only Homo sapiens datasets are supported when a dataset NCBI taxon id is declared."
    }
  ],
  "accepts": [
    "cells"
  ],
  "assumes": "scrna_specific",
  "extra_inputs": {
    "required": [],
    "optional": [],
    "conditional_required": [
      {
        "input": "groups",
        "execution": "mode",
        "op": "eq",
        "value": "group_emulated",
        "message": "groups is required when execution.mode=group_emulated because ANDREA partitions the dataset by group before running DigNet.",
        "usage": "ANDREA uses groups.tsv to create one DigNet child run per group; each child receives that group's expression matrix and DigNet itself does not consume groups.tsv."
      }
    ]
  },
  "artifacts_aux": [
    {
      "path_pattern": "dignet.log",
      "kind": "file",
      "require_non_empty": true,
      "description": "Combined stdout/stderr log from DigNet preprocessing, model loading and diffusion generation."
    },
    {
      "path_pattern": "raw/adj_final.csv",
      "kind": "file",
      "require_non_empty": true,
      "description": "Raw DigNet final directed adjacency/vote matrix before conversion to ANDREA network.csv."
    },
    {
      "path_pattern": "raw/model_config.json",
      "kind": "file",
      "require_non_empty": true,
      "description": "Resolved DigNet inference configuration, including selected pretrained model, PCA file, gene_set, metacell settings, ensemble and diffusion timesteps."
    },
    {
      "path_pattern": "raw/selected_genes.tsv",
      "kind": "file",
      "require_non_empty": true,
      "description": "Gene identifiers retained by DigNet after applying the selected KEGG or wrapper-generated gene set."
    }
  ],
  "outputs": {
    "directed": true,
    "sign": "none",
    "evidence": "association"
  },
  "progress": {
    "kind": "none",
    "note": "The selected DigNet public API runs preprocessing, then DigNet.test() executes independent diffusion ensemble members with optional joblib parallelism. It does not expose a stable progress callback; the wrapper reports coarse lifecycle states in progress.json and records upstream diagnostics in dignet.log."
  },
