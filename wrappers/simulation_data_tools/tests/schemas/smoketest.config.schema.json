{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/simulator-smoketest.config.schema.json",
  "title": "ANDREA Simulator Smoketest Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulator_id",
    "request",
    "expect_progress",
    "required_files"
  ],
  "properties": {
    "simulator_id": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "effective_extras",
        "inputs",
        "params",
        "runtime_resources"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        },
        "effective_extras": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "params": {
          "type": "object"
        },
        "runtime_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threads"],
          "properties": {
            "threads": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "expect_progress": {
      "type": "boolean"
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_truth_context_prefixes": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
