      }
    },
    {
      "name": "k_four",
      "param_overrides": {
        "k": 4,
        "iter_num": 200
      }
    },
    {
      "name": "decay_zero",
      "param_overrides": {
        "alpha": 0,
        "iter_num": 200
      }
    },
    {
      "name": "decay_one",
      "param_overrides": {
        "alpha": 1,
        "iter_num": 200
      }
    },
    {
      "name": "changed_seed",
      "param_overrides": {
        "seed": 17,
        "iter_num": 200
      }
    },
    {
      "name": "tf_candidates",
      "param_overrides": {
        "iter_num": 200
