{
  "extra_files": ["tf_list.txt"],
  "execution": {
    "mode": "global"
  },
  "checks": {
    "forbid_self_loops": true
  },
  "variants": [
    {
      "name": "raw",
      "param_overrides": {
        "sift_method": "none"
      }
    },
    {
      "name": "max_sift",
      "param_overrides": {
        "sift_method": "max"
      }
    },
    {
      "name": "meta_cells",
      "param_overrides": {
        "subsampling_method": "meta_cells",
        "subsampling_ratio": 0.5
      }
    }
  ]
}
