{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrea.dev/schemas/smoketest.config.schema.json",
  "title": "SmoketestConfig",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "execution"
      ]
    },
    {
      "required": [
        "variants"
      ],
      "properties": {
        "variants": {
          "items": {
            "required": [
              "execution"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "name": {
      "description": "Optional name for this smoketest variant.",
      "type": "string",
      "minLength": 1
    },
    "extra_files": {
      "description": "Extra input files to copy into /io/extra for this tool smoketest.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "execution": {
      "description": "Physical execution.json payload mounted in /io. It may be inherited by variants from the root config.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "global",
            "group_native",
            "column_native"
          ]
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional bulk observed-time contract. Requires enriched canonical timepoints and replicates TSVs. Supported by the Osaka runtime extension; older strict readers reject this field.",
          "required": [
            "schema_version",
            "time_basis",
            "time_unit",
            "time_origin",
            "sampling_design",
            "missing_values",
            "preprocessing",
            "provenance"
          ],
          "properties": {
            "schema_version": {
              "const": "bulk-temporal/1"
            },
            "time_basis": {
              "const": "observed"
            },
            "time_unit": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "time_origin": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "sampling_design": {
              "enum": [
                "longitudinal",
                "independent_samples"
              ]
            },
            "missing_values": {
              "const": "reject"
            },
            "preprocessing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "normalization",
                "transformation"
              ],
              "properties": {
                "normalization": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                },
                "transformation": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              }
            },
            "provenance": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    },
    "param_overrides": {
      "description": "Optional parameter overrides merged onto ToolSpec defaults and shared dev overrides for this smoketest variant.",
      "type": "object",
      "default": {}
    },
    "require_progress": {
      "description": "Whether the smoketest must observe progress.json during execution.",
      "type": "boolean",
      "default": true
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_group_context": {
          "description": "Whether network.csv must include at least one row with context starting with 'group:'.",
          "type": "boolean",
          "default": false
        },
        "require_unique_unordered_pairs": {
          "description": "Whether network.csv must contain at most one row per unordered source/target pair.",
          "type": "boolean",
          "default": false
        },
        "forbid_self_loops": {
          "description": "Whether network.csv must exclude rows where source == target.",
          "type": "boolean",
          "default": false
        },
        "allow_empty_network": {
          "type": "boolean",
          "default": false,
          "description": "Permit a scientifically valid header-only network for an explicitly selected empty export case."
        }
      },
      "default": {}
    },
    "variants": {
      "description": "Optional list of smoketest variants. Each entry uses the same shape as the root config except nested variants are not allowed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "extra_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "global",
                  "group_native",
                  "column_native"
                ]
              },
              "temporal": {
                "type": "object",
                "additionalProperties": false,
                "description": "Optional bulk observed-time contract. Requires enriched canonical timepoints and replicates TSVs. Supported by the Osaka runtime extension; older strict readers reject this field.",
                "required": [
                  "schema_version",
                  "time_basis",
                  "time_unit",
                  "time_origin",
                  "sampling_design",
                  "missing_values",
                  "preprocessing",
                  "provenance"
                ],
                "properties": {
                  "schema_version": {
                    "const": "bulk-temporal/1"
                  },
                  "time_basis": {
                    "const": "observed"
                  },
                  "time_unit": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "time_origin": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "sampling_design": {
                    "enum": [
                      "longitudinal",
                      "independent_samples"
                    ]
                  },
                  "missing_values": {
                    "const": "reject"
                  },
                  "preprocessing": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "normalization",
                      "transformation"
                    ],
                    "properties": {
                      "normalization": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": ".*\\S.*"
                      },
                      "transformation": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": ".*\\S.*"
                      }
                    }
                  },
                  "provenance": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  }
                }
              }
            }
          },
          "param_overrides": {
            "type": "object"
          },
          "require_progress": {
            "type": "boolean"
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "require_group_context": {
                "type": "boolean"
              },
              "require_unique_unordered_pairs": {
                "type": "boolean"
              },
              "forbid_self_loops": {
                "type": "boolean"
              },
              "allow_empty_network": {
                "type": "boolean",
                "default": false,
                "description": "Permit a scientifically valid header-only network for an explicitly selected empty export case."
              }
            }
          }
        }
      }
    }
  }
}
